<div class="container">
  <div class="row">
    <div class="col-md-3">
      <!-- ユーザー情報サイドバー -->
      <div class="card">
        <div class="card-body text-center">
          <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar, class: "rounded-circle mb-3", 
                          style: "width: 80px; height: 80px; object-fit: cover;" %>
          <% else %>
            <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center text-white mb-3"
                 style="width: 80px; height: 80px; font-size: 32px;">
              👨‍🍳
            </div>
          <% end %>
          <h5><%= @user.name %></h5>
          <div class="btn-group-vertical w-100">
            <%= link_to "投稿レシピ", user_path(@user), 
                        class: "btn #{'btn-primary' if request.path == user_path(@user)} #{'btn-outline-primary' unless request.path == user_path(@user)}" %>
            <%= link_to "お気に入り", favorites_user_path(@user), 
                        class: "btn #{'btn-primary' if request.path == favorites_user_path(@user)} #{'btn-outline-primary' unless request.path == favorites_user_path(@user)}" %>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-9">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
          <% if current_user == @user %>
            あなたのお気に入りレシピ
          <% else %>
            <%= @user.name %>さんのお気に入りレシピ
          <% end %>
        </h2>
        <span class="badge bg-secondary"><%= @recipes.total_count %>件</span>
      </div>
      
      <% if @recipes.any? %>
        <div class="row">
          <% @recipes.each do |recipe| %>
            <div class="col-md-4 mb-4">
              <div class="card recipe-card h-100">
                <div class="recipe-image-container position-relative">
                  <% if recipe.image.attached? %>
                    <%= link_to recipe_path(recipe) do %>
                      <%= image_tag recipe.image, class: "card-img-top recipe-card-image" %>
                    <% end %>
                  <% else %>
                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center recipe-placeholder">
                      <span class="text-muted">🍽️</span>
                    </div>
                  <% end %>
                  
                  <div class="position-absolute top-0 end-0 p-2">
                    <%= render 'shared/favorite_button', recipe: recipe %>
                  </div>
                </div>
                
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title">
                    <%= link_to recipe.title, recipe_path(recipe), class: "text-decoration-none" %>
                  </h5>
                  <p class="card-text text-muted flex-grow-1">
                    <%= truncate(recipe.description, length: 80) %>
                  </p>
                  
                  <div class="recipe-meta mb-3">
                    <span class="badge bg-primary me-1">⏰ <%= recipe.cooking_time %>分</span>
                    <span class="badge bg-success me-1">👥 <%= recipe.servings %>人分</span>
                    <span class="badge bg-info">👨‍🍳 <%= recipe.user.name %></span>
                  </div>
                  
                  <div class="d-flex justify-content-between align-items-center">
                    <%= render 'shared/rating_system', recipe: recipe %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        
        <!-- ページネーション -->
        <div class="d-flex justify-content-center mt-4">
          <%= paginate @recipes %>
        </div>
      <% else %>
        <div class="text-center py-5">
          <div class="mb-4">
            <span style="font-size: 4rem;">💔</span>
          </div>
          <h4>お気に入りレシピがありません</h4>
          <p class="text-muted">気になるレシピをお気に入りに追加してみましょう</p>
          <%= link_to "レシピを探す", recipes_path, class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>