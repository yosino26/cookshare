<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow">
      <div class="card-body p-5">
        <h2 class="text-center mb-4">👤 プロフィール編集</h2>

        <%= form_with model: @user, local: true, multipart: true do |f| %>
          <%= render 'shared/error_messages', object: @user %>

          <div class="text-center mb-4">
            <div class="avatar-preview mb-3">
              <% if @user.avatar.present? %>
                <%= image_tag @user.avatar, class: "rounded-circle", 
                             style: "width: 100px; height: 100px; object-fit: cover;",
                             id: "avatar-preview" %>
              <% else %>
                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto"
                     style="width: 100px; height: 100px; font-size: 2rem; color: #6c757d;"
                     id="avatar-preview">
                  👨‍🍳
                </div>
              <% end %>
            </div>
            
            <div class="mb-3">
              <%= f.label :avatar, "プロフィール画像", class: "form-label" %>
              <%= f.file_field :avatar, class: "form-control", accept: "image/*",
                              onchange: "previewAvatar(this)" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :name, "名前", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", maxlength: 20 %>
          </div>

          <div class="mb-4">
            <%= f.label :bio, "自己紹介", class: "form-label" %>
            <%= f.text_area :bio, class: "form-control", rows: 4, maxlength: 500,
                           placeholder: "料理への思いや得意な料理などを書いてください..." %>
            <small class="text-muted">最大500文字</small>
          </div>

          <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <%= link_to "キャンセル", user_path(@user), class: "btn btn-outline-secondary" %>
            <%= f.submit "更新する", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
function previewAvatar(input) {
  if (input.files && input.files[0]) {
    var reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('avatar-preview').innerHTML = 
        '<img src="' + e.target.result + '" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover;">';
    }
    reader.readAsDataURL(input.files[0]);
  }
}
</script>
