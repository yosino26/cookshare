<% content_for :page_title, "ダッシュボード" %>
<% content_for :page_description, "システム全体の統計情報と最近のアクティビティ" %>

<!-- 統計カードエリア -->
<div class="row mb-4">
  <!-- 総ユーザー数 -->
  <div class="col-lg-3 col-md-6 mb-3">
    <div class="card stat-card h-100">
      <div class="card-body text-center">
        <div class="d-flex align-items-center justify-content-center mb-2">
          <div class="rounded-circle bg-primary bg-opacity-10 p-3">
            <i class="fas fa-users text-primary fa-2x"></i>
          </div>
        </div>
        <h3 class="mb-1"><%= number_with_delimiter(@stats[:total_users]) %></h3>
        <p class="text-muted mb-0">総ユーザー数</p>
        <small class="text-success">
          <i class="fas fa-arrow-up"></i>
          今日 +<%= @stats[:today_users] %>
        </small>
      </div>
    </div>
  </div>

  <!-- 総レシピ数 -->
  <div class="col-lg-3 col-md-6 mb-3">
    <div class="card stat-card h-100">
      <div class="card-body text-center">
        <div class="d-flex align-items-center justify-content-center mb-2">
          <div class="rounded-circle bg-success bg-opacity-10 p-3">
            <i class="fas fa-book text-success fa-2x"></i>
          </div>
        </div>
        <h3 class="mb-1"><%= number_with_delimiter(@stats[:total_recipes]) %></h3>
        <p class="text-muted mb-0">総レシピ数</p>
        <small class="text-success">
          <i class="fas fa-arrow-up"></i>
          今日 +<%= @stats[:today_recipes] %>
        </small>
      </div>
    </div>
  </div>

  <!-- 総コメント数 -->
  <div class="col-lg-3 col-md-6 mb-3">
    <div class="card stat-card h-100">
      <div class="card-body text-center">
        <div class="d-flex align-items-center justify-content-center mb-2">
          <div class="rounded-circle bg-info bg-opacity-10 p-3">
            <i class="fas fa-comments text-info fa-2x"></i>
          </div>
        </div>
        <h3 class="mb-1"><%= number_with_delimiter(@stats[:total_comments]) %></h3>
        <p class="text-muted mb-0">総コメント数</p>
        <small class="text-success">
          <i class="fas fa-arrow-up"></i>
          今日 +<%= @stats[:today_comments] %>
        </small>
      </div>
    </div>
  </div>

  <!-- 未対応レポート -->
  <div class="col-lg-3 col-md-6 mb-3">
    <div class="card stat-card h-100">
      <div class="card-body text-center">
        <div class="d-flex align-items-center justify-content-center mb-2">
          <div class="rounded-circle bg-warning bg-opacity-10 p-3">
            <i class="fas fa-flag text-warning fa-2x"></i>
          </div>
        </div>
        <h3 class="mb-1 <%= 'text-danger' if @stats[:pending_reports] > 0 %>">
          <%= @stats[:pending_reports] %>
        </h3>
        <p class="text-muted mb-0">未対応レポート</p>
        <% if @stats[:pending_reports] > 0 %>
          <small class="text-danger">
            <i class="fas fa-exclamation-triangle"></i>
            対応が必要です
          </small>
        <% else %>
          <small class="text-success">
            <i class="fas fa-check"></i>
            全て対応済み
          </small>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- レポート統計チャートエリア -->
<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">
          <i class="fas fa-chart-pie me-2"></i>
          レポートステータス
        </h5>
      </div>
      <div class="card-body">
        <canvas id="reportStatusChart" width="400" height="200"></canvas>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">
          <i class="fas fa-chart-bar me-2"></i>
          週間アクティビティ
        </h5>
      </div>
      <div class="card-body">
        <div class="row text-center">
          <div class="col-4">
            <h4 class="text-primary"><%= @stats[:week_users] %></h4>
            <small class="text-muted">新規ユーザー</small>
          </div>
          <div class="col-4">
            <h4 class="text-success"><%= @stats[:week_recipes] %></h4>
            <small class="text-muted">新規レシピ</small>
          </div>
          <div class="col-4">
            <h4 class="text-info"><%= @stats[:week_comments] %></h4>
            <small class="text-muted">新規コメント</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 最近のアクティビティ -->
<div class="row">
  <!-- 最近のユーザー -->
  <div class="col-md-6 mb-4">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          <i class="fas fa-user-plus me-2"></i>
          最近の新規ユーザー
        </h5>
        <%= link_to "全て見る", admin_users_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
      <div class="card-body">
        <% if @recent_activities[:recent_users].any? %>
          <% @recent_activities[:recent_users].each do |user| %>
            <div class="d-flex align-items-center mb-3">
              <div class="me-3">
                <% if user.avatar.attached? %>
                  <%= image_tag user.avatar, class: "rounded-circle", size: "40x40" %>
                <% else %>
                  <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="fas fa-user text-white"></i>
                  </div>
                <% end %>
              </div>
              <div class="flex-grow-1">
                <h6 class="mb-0"><%= user.display_name %></h6>
                <small class="text-muted">
                  <i class="fas fa-clock me-1"></i>
                  <%= time_ago_in_words(user.created_at) %>前に登録
                </small>
              </div>
              <div>
                <%= link_to admin_user_path(user), class: "btn btn-sm btn-outline-secondary" do %>
                  <i class="fas fa-eye"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted mb-0">
            <i class="fas fa-info-circle me-2"></i>
            最近の新規ユーザーはいません
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 最近のレシピ -->
  <div class="col-md-6 mb-4">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          <i class="fas fa-book me-2"></i>
          最近のレシピ
        </h5>
        <%= link_to "全て見る", admin_recipes_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
      <div class="card-body">
        <% if @recent_activities[:recent_recipes].any? %>
          <% @recent_activities[:recent_recipes].each do |recipe| %>
            <div class="d-flex align-items-center mb-3">
              <div class="me-3">
                <% if recipe.image.attached? %>
                  <%= image_tag recipe.image, class: "rounded", size: "40x40", style: "object-fit: cover;" %>
                <% else %>
                  <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="fas fa-utensils text-muted"></i>
                  </div>
                <% end %>
              </div>
              <div class="flex-grow-1">
                <h6 class="mb-0"><%= truncate(recipe.title, length: 30) %></h6>
                <small class="text-muted">
                  by <%= recipe.user.display_name %> • 
                  <%= time_ago_in_words(recipe.created_at) %>前
                </small>
              </div>
              <div>
                <%= link_to admin_recipe_path(recipe), class: "btn btn-sm btn-outline-secondary" do %>
                  <i class="fas fa-eye"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted mb-0">
            <i class="fas fa-info-circle me-2"></i>
            最近のレシピはありません
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- 未対応レポート -->
<% if @pending_reports.any? %>
  <div class="card">
    <div class="card-header bg-warning bg-opacity-10">
      <h5 class="mb-0 text-warning">
        <i class="fas fa-exclamation-triangle me-2"></i>
        対応が必要なレポート
      </h5>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>報告者</th>
              <th>対象</th>
              <th>理由</th>
              <th>日時</th>
              <th>アクション</th>
            </tr>
          </thead>
          <tbody>
            <% @pending_reports.each do |report| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <small class="text-muted">by</small>
                    <span class="ms-1"><%= report.reporter.display_name %></span>
                  </div>
                </td>
                <td>
                  <span class="badge bg-secondary"><%= report.reportable_type_japanese %></span>
                  <span class="ms-1"><%= truncate(report.reportable_title, length: 30) %></span>
                </td>
                <td><%= truncate(report.reason, length: 50) %></td>
                <td>
                  <small class="text-muted">
                    <%= time_ago_in_words(report.created_at) %>前
                  </small>
                </td>
                <td>
                  <%= link_to admin_report_path(report), class: "btn btn-sm btn-primary" do %>
                    <i class="fas fa-eye me-1"></i>確認
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="text-center mt-3">
        <%= link_to admin_reports_path, class: "btn btn-warning" do %>
          <i class="fas fa-flag me-2"></i>
          全てのレポートを管理
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<!-- Chart.js用スクリプト -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // レポートステータス円グラフ
  const reportCtx = document.getElementById('reportStatusChart').getContext('2d');
  new Chart(reportCtx, {
    type: 'doughnut',
    data: {
      labels: ['未対応', '調査中', '解決済み', '却下'],
      datasets: [{
        data: [
          <%= @stats[:pending_reports] %>,
          <%= @stats[:investigating_reports] %>,
          <%= @stats[:resolved_reports] %>,
          <%= @stats[:dismissed_reports] %>
        ],
        backgroundColor: [
          '#fbbf24',
          '#3b82f6',
          '#10b981',
          '#6b7280'
        ],
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        }
      }
    }
  });
});
</script>