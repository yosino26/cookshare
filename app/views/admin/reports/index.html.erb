<% content_for :page_title, "レポート管理" %>
<% content_for :page_description, "ユーザーからの報告内容を確認・対応" %>

<!-- 統計サマリー -->
<div class="row mb-4">
  <div class="col-md-12">
    <div class="card">
      <div class="card-body">
        <div class="row text-center">
          <div class="col-md-2">
            <h4 class="text-primary mb-0"><%= @stats[:total] %></h4>
            <small class="text-muted">総数</small>
          </div>
          <div class="col-md-2">
            <h4 class="text-warning mb-0"><%= @stats[:pending] %></h4>
            <small class="text-muted">未対応</small>
          </div>
          <div class="col-md-2">
            <h4 class="text-info mb-0"><%= @stats[:investigating] %></h4>
            <small class="text-muted">調査中</small>
          </div>
          <div class="col-md-2">
            <h4 class="text-success mb-0"><%= @stats[:resolved] %></h4>
            <small class="text-muted">解決済み</small>
          </div>
          <div class="col-md-2">
            <h4 class="text-secondary mb-0"><%= @stats[:dismissed] %></h4>
            <small class="text-muted">却下</small>
          </div>
          <div class="col-md-2">
            <h4 class="text-danger mb-0"><%= @stats[:today] %></h4>
            <small class="text-muted">今日</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- フィルター・検索フォーム -->
<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">
      <i class="fas fa-filter me-2"></i>
      フィルター・検索
    </h5>
  </div>
  <div class="card-body">
    <%= form_with url: admin_reports_path, method: :get, local: true, class: "row g-3" do |form| %>
      <!-- ステータスフィルター -->
      <div class="col-md-3">
        <%= form.label :status, "ステータス", class: "form-label" %>
        <%= form.select :status, 
            options_for_select([
              ['全て', ''],
              ['未対応', 'pending'],
              ['調査中', 'investigating'],
              ['解決済み', 'resolved'],
              ['却下', 'dismissed']
            ], @filter_params[:status]), 
            {}, 
            { class: "form-select" } %>
      </div>

      <!-- 報告対象タイプフィルター -->
      <div class="col-md-3">
        <%= form.label :reportable_type, "対象タイプ", class: "form-label" %>
        <%= form.select :reportable_type, 
            options_for_select([
              ['全て', ''],
              ['レシピ', 'Recipe'],
              ['コメント', 'Comment'],
              ['ユーザー', 'User']
            ], @filter_params[:reportable_type]), 
            {}, 
            { class: "form-select" } %>
      </div>

      <!-- 期間フィルター（開始） -->
      <div class="col-md-2">
        <%= form.label :date_from, "開始日", class: "form-label" %>
        <%= form.date_field :date_from, 
            value: @filter_params[:date_from], 
            class: "form-control" %>
      </div>

      <!-- 期間フィルター（終了） -->
      <div class="col-md-2">
        <%= form.label :date_to, "終了日", class: "form-label" %>
        <%= form.date_field :date_to, 
            value: @filter_params[:date_to], 
            class: "form-control" %>
      </div>

      <!-- 検索・リセットボタン -->
      <div class="col-md-2 d-flex align-items-end">
        <div class="btn-group w-100" role="group">
          <%= form.submit "検索", class: "btn btn-primary" %>
          <%= link_to "リセット", admin_reports_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- レポート一覧テーブル -->
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">
      <i class="fas fa-list me-2"></i>
      レポート一覧 (<%= @reports.total_count %>件)
    </h5>
    <!-- ソートドロップダウン -->
    <div class="dropdown">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="fas fa-sort me-1"></i>並び替え
      </button>
      <ul class="dropdown-menu">
        <li>
          <%= link_to admin_reports_path(params.permit!.merge(sort: 'created_at', direction: 'desc')), 
              class: "dropdown-item #{'active' if @filter_params[:sort] == 'created_at' && @filter_params[:direction] == 'desc'}" do %>
            <i class="fas fa-clock me-2"></i>新しい順
          <% end %>
        </li>
        <li>
          <%= link_to admin_reports_path(params.permit!.merge(sort: 'created_at', direction: 'asc')), 
              class: "dropdown-item #{'active' if @filter_params[:sort] == 'created_at' && @filter_params[:direction] == 'asc'}" do %>
            <i class="fas fa-clock me-2"></i>古い順
          <% end %>
        </li>
        <li>
          <%= link_to admin_reports_path(params.permit!.merge(sort: 'status', direction: 'asc')), 
              class: "dropdown-item #{'active' if @filter_params[:sort] == 'status'}" do %>
            <i class="fas fa-flag me-2"></i>ステータス順
          <% end %>
        </li>
      </ul>
    </div>
  </div>

  <div class="card-body p-0">
    <% if @reports.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">
                <i class="fas fa-flag me-1"></i>ステータス
              </th>
              <th scope="col">
                <i class="fas fa-user me-1"></i>報告者
              </th>
              <th scope="col">
                <i class="fas fa-bullseye me-1"></i>対象
              </th>
              <th scope="col">
                <i class="fas fa-comment me-1"></i>理由
              </th>
              <th scope="col">
                <i class="fas fa-clock me-1"></i>報告日時
              </th>
              <th scope="col" width="150">
                <i class="fas fa-cogs me-1"></i>アクション
              </th>
            </tr>
          </thead>
          <tbody>
            <% @reports.each do |report| %>
              <tr class="<%= 'table-warning' if report.pending? %>">
                <!-- ステータス -->
                <td>
                  <% case report.status %>
                  <% when 'pending' %>
                    <span class="badge bg-warning text-dark">
                      <i class="fas fa-clock me-1"></i>未対応
                    </span>
                  <% when 'investigating' %>
                    <span class="badge bg-info">
                      <i class="fas fa-search me-1"></i>調査中
                    </span>
                  <% when 'resolved' %>
                    <span class="badge bg-success">
                      <i class="fas fa-check me-1"></i>解決済み
                    </span>
                  <% when 'dismissed' %>
                    <span class="badge bg-secondary">
                      <i class="fas fa-times me-1"></i>却下
                    </span>
                  <% end %>
                </td>

                <!-- 報告者 -->
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-2">
                      <% if report.reporter.avatar.attached? %>
                        <%= image_tag report.reporter.avatar, 
                            class: "rounded-circle", 
                            size: "30x30" %>
                      <% else %>
                        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" 
                             style="width: 30px; height: 30px;">
                          <i class="fas fa-user text-white small"></i>
                        </div>
                      <% end %>
                    </div>
                    <div>
                      <div class="fw-bold"><%= report.reporter.display_name %></div>
                      <small class="text-muted"><%= report.reporter.email %></small>
                    </div>
                  </div>
                </td>

                <!-- 対象 -->
                <td>
                  <div>
                    <span class="badge bg-light text-dark border">
                      <%= report.reportable_type_japanese %>
                    </span>
                  </div>
                  <div class="mt-1">
                    <strong><%= truncate(report.reportable_title, length: 40) %></strong>
                  </div>
                  <% if report.reportable_type == 'Recipe' %>
                    <small class="text-muted">
                      by <%= report.reportable.user.display_name %>
                    </small>
                  <% elsif report.reportable_type == 'Comment' %>
                    <small class="text-muted">
                      on <%= truncate(report.reportable.recipe.title, length: 20) %>
                    </small>
                  <% end %>
                </td>

                <!-- 理由 -->
                <td>
                  <div class="mb-1">
                    <strong><%= truncate(report.reason, length: 50) %></strong>
                  </div>
                  <% if report.description.present? %>
                    <small class="text-muted">
                      <%= truncate(report.description, length: 80) %>
                    </small>
                  <% end %>
                </td>

                <!-- 報告日時 -->
                <td>
                  <div><%= report.created_at.strftime("%Y/%m/%d") %></div>
                  <small class="text-muted">
                    <%= report.created_at.strftime("%H:%M") %>
                    (<%= time_ago_in_words(report.created_at) %>前)
                  </small>
                </td>

                <!-- アクション -->
                <td>
                  <div class="btn-group-vertical w-100" role="group">
                    <!-- 詳細確認 -->
                    <%= link_to admin_report_path(report), 
                        class: "btn btn-sm btn-outline-primary mb-1" do %>
                      <i class="fas fa-eye me-1"></i>詳細
                    <% end %>

                    <!-- クイックアクション（未対応の場合のみ） -->
                    <% if report.pending? %>
                      <div class="btn-group" role="group">
                        <%= link_to investigate_admin_report_path(report), 
                            method: :patch,
                            data: { 
                              turbo_method: :patch,
                              turbo_confirm: "調査中に変更しますか？" 
                            },
                            class: "btn btn-sm btn-info" do %>
                          <i class="fas fa-search"></i>
                        <% end %>
                        
                        <button type="button" 
                                class="btn btn-sm btn-success dropdown-toggle dropdown-toggle-split" 
                                data-bs-toggle="dropdown">
                          <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                          <li>
                            <%= link_to resolve_admin_report_path(report), 
                                method: :patch,
                                data: { 
                                  turbo_method: :patch,
                                  turbo_confirm: "このレポートを解決済みにしますか？" 
                                },
                                class: "dropdown-item text-success" do %>
                              <i class="fas fa-check me-2"></i>解決
                            <% end %>
                          </li>
                          <li>
                            <%= link_to dismiss_admin_report_path(report), 
                                method: :patch,
                                data: { 
                                  turbo_method: :patch,
                                  turbo_confirm: "このレポートを却下しますか？" 
                                },
                                class: "dropdown-item text-secondary" do %>
                              <i class="fas fa-times me-2"></i>却下
                            <% end %>
                          </li>
                        </ul>
                      </div>
                    <% elsif report.investigating? %>
                      <small class="text-muted">
                        <i class="fas fa-user me-1"></i>
                        <%= report.admin_user.display_name %>が調査中
                      </small>
                    <% else %>
                      <small class="text-muted">
                        <i class="fas fa-user me-1"></i>
                        <%= report.admin_user.display_name %>が対応済み
                      </small>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- ページネーション -->
      <div class="card-footer">
        <div class="d-flex justify-content-between align-items-center">
          <div class="text-muted">
            <%= page_entries_info @reports, entry_name: 'レポート' %>
          </div>
          <%= paginate @reports, theme: 'bootstrap' %>
        </div>
      </div>
    <% else %>
      <!-- 空状態 -->
      <div class="text-center py-5">
        <div class="mb-4">
          <i class="fas fa-flag text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
        </div>
        <h4 class="text-muted">レポートが見つかりません</h4>
        <p class="text-muted mb-0">
          指定した条件に該当するレポートがありません。<br>
          検索条件を変更して再度お試しください。
        </p>
        <div class="mt-3">
          <%= link_to "フィルターをリセット", admin_reports_path, class: "btn btn-outline-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- スタイル調整 -->
<style>
  .table td {
    vertical-align: middle;
  }
  
  .table .btn-group-vertical .btn {
    font-size: 0.75rem;
  }
  
  .dropdown-toggle-split {
    padding-left: 0.375rem;
    padding-right: 0.375rem;
  }
  
  .table-warning td {
    background-color: rgba(255, 193, 7, 0.1);
  }
</style>