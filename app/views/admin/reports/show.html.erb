<% content_for :page_title, "レポート詳細" %>
<% content_for :page_description, "#{@report.reportable_type_japanese}への報告内容" %>
<% content_for :page_actions do %>
  <%= link_to admin_reports_path, class: "btn btn-outline-secondary" do %>
    <i class="fas fa-arrow-left me-1"></i>一覧に戻る
  <% end %>
<% end %>

<!-- ブレッドクラム設定 -->
<%
@breadcrumbs = [
  { name: "ダッシュボード", path: admin_root_path },
  { name: "レポート管理", path: admin_reports_path },
  { name: "詳細", path: admin_report_path(@report) }
]
%>

<div class="row">
  <!-- メイン情報 -->
  <div class="col-lg-8">
    <!-- レポート基本情報 -->
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-start">
        <div>
          <h5 class="mb-1">
            <span class="badge bg-<%= @report.status_color %> me-2">
              <%= @report.status_japanese %>
            </span>
            <%= @report.reportable_type_japanese %>への報告
          </h5>
          <small class="text-muted">
            <i class="fas fa-clock me-1"></i>
            <%= @report.created_at.strftime("%Y年%m月%d日 %H:%M") %>
            (<%= time_ago_in_words(@report.created_at) %>前)
          </small>
        </div>
        <div>
          <span class="badge bg-info">ID: <%= @report.id %></span>
        </div>
      </div>
      <div class="card-body">
        <!-- 報告者情報 -->
        <div class="row mb-4">
          <div class="col-md-6">
            <h6 class="text-muted mb-2">
              <i class="fas fa-user me-2"></i>報告者
            </h6>
            <div class="d-flex align-items-center">
              <% if @report.reporter.avatar.attached? %>
                <%= image_tag @report.reporter.avatar, 
                    class: "rounded-circle me-3", size: "50x50" %>
              <% else %>
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3" 
                     style="width: 50px; height: 50px;">
                  <i class="fas fa-user text-white"></i>
                </div>
              <% end %>
              <div>
                <div class="fw-medium">
                  <%= link_to @report.reporter.display_name, admin_user_path(@report.reporter), 
                      class: "text-decoration-none" %>
                </div>
                <small class="text-muted"><%= @report.reporter.email %></small>
                <div>
                  <span class="badge bg-light text-dark">
                    登録: <%= @report.reporter.created_at.strftime("%Y/%m/%d") %>
                  </span>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <h6 class="text-muted mb-2">
              <i class="fas fa-target me-2"></i>報告対象
            </h6>
            <div class="d-flex align-items-start">
              <div class="me-3">
                <% case @report.reportable_type %>
                <% when 'Recipe' %>
                  <% if @report.reportable.image.attached? %>
                    <%= image_tag @report.reportable.image, 
                        class: "rounded", size: "50x50", style: "object-fit: cover;" %>
                  <% else %>
                    <div class="rounded bg-light d-flex align-items-center justify-content-center" 
                         style="width: 50px; height: 50px;">
                      <i class="fas fa-utensils text-muted"></i>
                    </div>
                  <% end %>
                <% when 'Comment' %>
                  <div class="rounded bg-info bg-opacity-10 d-flex align-items-center justify-content-center" 
                       style="width: 50px; height: 50px;">
                    <i class="fas fa-comment text-info"></i>
                  </div>
                <% when 'User' %>
                  <% if @report.reportable.avatar.attached? %>
                    <%= image_tag @report.reportable.avatar, 
                        class: "rounded-circle", size: "50x50" %>
                  <% else %>
                    <div class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center" 
                         style="width: 50px; height: 50px;">
                      <i class="fas fa-user text-warning"></i>
                    </div>
                  <% end %>
                <% end %>
              </div>
              <div class="flex-grow-1">
                <div class="fw-medium">
                  <%= link_to @report.reportable_title, @report.reportable_admin_path, 
                      class: "text-decoration-none" %>
                </div>
                <small class="text-muted">
                  by <%= @report.reportable_user_name %>
                </small>
                <div class="mt-1">
                  <span class="badge bg-light text-dark">
                    作成: <%= @report.reportable.created_at.strftime("%Y/%m/%d") %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 報告内容 -->
        <div class="mb-4">
          <h6 class="text-muted mb-2">
            <i class="fas fa-exclamation-triangle me-2"></i>報告理由
          </h6>
          <div class="bg-light p-3 rounded">
            <p class="mb-0"><%= @report.reason %></p>
          </div>
        </div>

        <% if @report.description.present? %>
          <div class="mb-4">
            <h6 class="text-muted mb-2">
              <i class="fas fa-file-text me-2"></i>詳細説明
            </h6>
            <div class="bg-light p-3 rounded">
              <p class="mb-0" style="white-space: pre-line;"><%= @report.description %></p>
            </div>
          </div>
        <% end %>

        <!-- 報告対象のプレビュー -->
        <div class="mb-4">
          <h6 class="text-muted mb-2">
            <i class="fas fa-eye me-2"></i>対象コンテンツ
          </h6>
          <div class="border rounded p-3">
            <%= render "admin/reports/reportable_preview", report: @report %>
          </div>
        </div>
      </div>
    </div>

    <!-- 管理者ノート -->
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">
          <i class="fas fa-sticky-note me-2"></i>管理者ノート
        </h5>
      </div>
      <div class="card-body">
        <%= form_with model: [:admin, @report], class: "mb-3" do |form| %>
          <div class="mb-3">
            <%= form.label :admin_note, "内部メモ（管理者のみ閲覧可能）", class: "form-label" %>
            <%= form.text_area :admin_note, rows: 4, class: "form-control", 
                placeholder: "調査内容、対応状況、今後の方針など..." %>
          </div>
          <div class="text-end">
            <%= form.submit "ノートを保存", class: "btn btn-outline-primary" %>
          </div>
        <% end %>

        <% if @report.admin_note.present? %>
          <div class="bg-light p-3 rounded">
            <small class="text-muted d-block mb-2">
              <%= @report.updated_at.strftime("%Y年%m月%d日 %H:%M") %>更新
            </small>
            <div style="white-space: pre-line;"><%= @report.admin_note %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- サイドバー -->
  <div class="col-lg-4">
    <!-- アクションパネル -->
    <div class="card mb-4">
      <div class="card-header">
        <h5 class="mb-0">
          <i class="fas fa-cog me-2"></i>アクション
        </h5>
      </div>
      <div class="card-body">
        <!-- ステータス変更 -->
        <div class="mb-3">
          <label class="form-label">ステータス変更</label>
          <div class="d-grid gap-2">
            <% unless @report.investigating? %>
              <%= link_to admin_report_path(@report), 
                  method: :patch,
                  params: { report: { status: :investigating } },
                  class: "btn btn-outline-info btn-sm",
                  data: { 
                    turbo_method: :patch,
                    confirm: "ステータスを「調査中」に変更しますか？"
                  } do %>
                <i class="fas fa-search me-1"></i>調査中にする
              <% end %>
            <% end %>

            <% unless @report.resolved? %>
              <%= link_to admin_report_path(@report), 
                  method: :patch,
                  params: { report: { status: :resolved } },
                  class: "btn btn-outline-success btn-sm",
                  data: { 
                    turbo_method: :patch,
                    confirm: "ステータスを「解決済み」に変更しますか？"
                  } do %>
                <i class="fas fa-check me-1"></i>解決済みにする
              <% end %>
            <% end %>

            <% unless @report.dismissed? %>
              <%= link_to admin_report_path(@report), 
                  method: :patch,
                  params: { report: { status: :dismissed } },
                  class: "btn btn-outline-secondary btn-sm",
                  data: { 
                    turbo_method: :patch,
                    confirm: "このレポートを却下しますか？"
                  } do %>
                <i class="fas fa-times me-1"></i>却下する
              <% end %>
            <% end %>

            <% if @report.pending? %>
              <%= link_to admin_report_path(@report), 
                  method: :patch,
                  params: { report: { status: :pending } },
                  class: "btn btn-outline-warning btn-sm",
                  data: { 
                    turbo_method: :patch,
                    confirm: "ステータスを「未対応」に戻しますか？"
                  } do %>
                <i class="fas fa-undo me-1"></i>未対応に戻す
              <% end %>
            <% end %>
          </div>
        </div>

        <hr>

        <!-- 対象コンテンツアクション -->
        <div class="mb-3">
          <label class="form-label">対象コンテンツ</label>
          <div class="d-grid gap-2">
            <%= link_to @report.reportable_admin_path, class: "btn btn-outline-primary btn-sm" do %>
              <i class="fas fa-external-link-alt me-1"></i>詳細を確認
            <% end %>

            <% if @report.reportable_type == 'User' %>
              <button type="button" class="btn btn-outline-danger btn-sm" 
                      data-bs-toggle="modal" data-bs-target="#suspendUserModal">
                <i class="fas fa-user-slash me-1"></i>ユーザーを停止
              </button>
            <% end %>

            <% if @report.reportable_type == 'Recipe' %>
              <button type="button" class="btn btn-outline-warning btn-sm"
                      data-bs-toggle="modal" data-bs-target="#hideRecipeModal">
                <i class="fas fa-eye-slash me-1"></i>レシピを非公開
              </button>
            <% end %>

            <% if @report.reportable_type == 'Comment' %>
              <button type="button" class="btn btn-outline-danger btn-sm"
                      data-bs-toggle="modal" data-bs-target="#deleteCommentModal">
                <i class="fas fa-trash me-1"></i>コメントを削除
              </button>
            <% end %>
          </div>
        </div>

        <hr>

        <!-- 削除 -->
        <div class="d-grid">
          <%= link_to admin_report_path(@report), 
              method: :delete,
              class: "btn btn-outline-danger btn-sm",
              data: { 
                turbo_method: :delete,
                confirm: "このレポートを完全に削除しますか？この操作は取り消せません。"
              } do %>
            <i class="fas fa-trash me-1"></i>レポートを削除
          <% end %>
        </div>
      </div>
    </div>

    <!-- 関連情報 -->
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">
          <i class="fas fa-info-circle me-2"></i>関連情報
        </h5>
      </div>
      <div class="card-body">
        <!-- 報告者の他のレポート -->
        <% if @reporter_reports.any? %>
          <div class="mb-3">
            <h6 class="text-muted">この報告者の他のレポート</h6>
            <ul class="list-unstyled">
              <% @reporter_reports.each do |report| %>
                <li class="mb-1">
                  <%= link_to admin_report_path(report), class: "text-decoration-none small" do %>
                    <span class="badge bg-<%= report.status_color %>"><%= report.status_japanese %></span>
                    <%= truncate(report.reason, length: 30) %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- 統計情報 -->
        <div>
          <h6 class="text-muted">統計</h6>
          <ul class="list-unstyled small">
            <li>報告者レポート数: <%= @reporter_reports.count %>件</li>
            <li>対象レポート数: <%= @target_reports.count %>件</li>
            <li>今月のレポート数: <%= Report.where(created_at: Time.current.beginning_of_month..Time.current.end_of_month).count %>件</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- モーダル群 --><!-- ユーザー停止モーダル -->
<% if @report.reportable_type == 'User' %>
  <div class="modal fade" id="suspendUserModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">
            <i class="fas fa-user-slash text-danger me-2"></i>
            ユーザーを停止
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: suspend_admin_user_path(@report.reportable), 
            method: :patch, class: "modal-form" do |form| %>
          <div class="modal-body">
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <strong><%= @report.reportable.display_name %></strong>さんのアカウントを停止しますか？
            </div>
            <div class="mb-3">
              <%= form.label :suspend_reason, "停止理由", class: "form-label" %>
              <%= form.text_area :suspend_reason, rows: 3, class: "form-control", 
                  placeholder: "停止理由を入力してください..." %>
            </div>
            <div class="mb-3">
              <%= form.label :suspend_duration, "停止期間", class: "form-label" %>
              <%= form.select :suspend_duration, 
                  options_for_select([
                    ['1日', '1'],
                    ['3日', '3'],
                    ['1週間', '7'],
                    ['1ヶ月', '30'],
                    ['無期限', '0']
                  ]), 
                  { prompt: '期間を選択...' },
                  { class: "form-select" } %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
            <%= form.submit "ユーザーを停止", class: "btn btn-danger" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<!-- レシピ非公開モーダル -->
<% if @report.reportable_type == 'Recipe' %>
  <div class="modal fade" id="hideRecipeModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">
            <i class="fas fa-eye-slash text-warning me-2"></i>
            レシピを非公開
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: hide_admin_recipe_path(@report.reportable), 
            method: :patch, class: "modal-form" do |form| %>
          <div class="modal-body">
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle me-2"></i>
              レシピ「<strong><%= @report.reportable.title %></strong>」を非公開にしますか？
            </div>
            <div class="mb-3">
              <%= form.label :hide_reason, "非公開理由", class: "form-label" %>
              <%= form.text_area :hide_reason, rows: 3, class: "form-control", 
                  placeholder: "非公開にする理由を入力してください..." %>
            </div>
            <div class="form-check">
              <%= form.check_box :notify_user, class: "form-check-input" %>
              <%= form.label :notify_user, "ユーザーに通知する", class: "form-check-label" %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
            <%= form.submit "非公開にする", class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<!-- コメント削除モーダル -->
<% if @report.reportable_type == 'Comment' %>
  <div class="modal fade" id="deleteCommentModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">
            <i class="fas fa-trash text-danger me-2"></i>
            コメントを削除
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_with url: admin_comment_path(@report.reportable), 
            method: :delete, class: "modal-form" do |form| %>
          <div class="modal-body">
            <div class="alert alert-danger">
              <i class="fas fa-exclamation-triangle me-2"></i>
              このコメントを削除しますか？この操作は取り消せません。
            </div>
            <div class="bg-light p-3 rounded mb-3">
              <%= truncate(@report.reportable.content, length: 200) %>
            </div>
            <div class="mb-3">
              <%= form.label :delete_reason, "削除理由", class: "form-label" %>
              <%= form.text_area :delete_reason, rows: 3, class: "form-control", 
                  placeholder: "削除理由を入力してください..." %>
            </div>
            <div class="form-check">
              <%= form.check_box :notify_user, class: "form-check-input" %>
              <%= form.label :notify_user, "ユーザーに通知する", class: "form-check-label" %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
            <%= form.submit "コメントを削除", class: "btn btn-danger" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>