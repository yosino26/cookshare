<% content_for :page_title, "レポート詳細" %>
<% content_for :page_description, "#{@report.reportable_type_japanese}への報告内容" %>
<% content_for :page_actions do %>
  <%= link_to admin_reports_path, class: "btn btn-outline-secondary" do %>
    <i class="fas fa-arrow-left me-1"></i>一覧に戻る
  <% end %>
<% end %>

<%
@breadcrumbs = [
  { name: "ダッシュボード", path: admin_root_path },
  { name: "レポート管理", path: admin_reports_path },
  { name: "詳細", path: admin_report_path(@report) }
]
%>

<div class="row">
  <!-- メイン情報 -->
  <div class="col-lg-8">
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-start">
        <div>
          <h5 class="mb-1">
            <span class="badge bg-<%= @report.status_color %> me-2">
              <%= @report.status_japanese %>
            </span>
            <%= @report.reportable_type_japanese %>への報告
          </h5>
          <small class="text-muted">
            <% owner =
                 case @report.reportable
                 when Recipe, Comment then @report.reportable&.user
                 when User            then @report.reportable
                 end %>
            by <%= owner&.respond_to?(:display_name) ? owner.display_name : (owner&.name || '不明') %>
          </small>
        </div>
        <div>
          <span class="badge bg-info">ID: <%= @report.id %></span>
        </div>
      </div>

      <div class="card-body">
        <!-- 報告者・対象 -->
        <div class="row mb-4">
          <div class="col-md-6">
            <h6 class="text-muted mb-2"><i class="fas fa-user me-2"></i>報告者</h6>
            <div class="d-flex align-items-center">
              <% if @report.reporter.avatar.attached? %>
                <%= image_tag @report.reporter.avatar, class: "rounded-circle me-3", size: "50x50" %>
              <% else %>
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3" style="width:50px;height:50px;">
                  <i class="fas fa-user text-white"></i>
                </div>
              <% end %>
              <div class="fw-medium">
                <%= @report.reporter.display_name %>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <h6 class="text-muted mb-2"><i class="fas fa-target me-2"></i>報告対象</h6>
            <div class="fw-medium">
              <%= link_to @report.reportable_title, @report.reportable_admin_path, class: "text-decoration-none" %>
            </div>
            <small class="text-muted">by <%= report_owner_name(@report) %></small>
          </div>
        </div>

        <!-- 理由 -->
        <div class="mb-4">
          <h6 class="text-muted mb-2"><i class="fas fa-exclamation-triangle me-2"></i>報告理由</h6>
          <div class="bg-light p-3 rounded">
            <p class="mb-0"><%= @report.reason %></p>
          </div>
        </div>

        <% if @report.description.present? %>
          <div class="mb-4">
            <h6 class="text-muted mb-2"><i class="fas fa-file-text me-2"></i>詳細説明</h6>
            <div class="bg-light p-3 rounded">
              <p class="mb-0" style="white-space: pre-line;"><%= @report.description %></p>
            </div>
          </div>
        <% end %>

        <!-- プレビュー -->
        <div class="mb-4">
          <h6 class="text-muted mb-2"><i class="fas fa-eye me-2"></i>対象コンテンツ</h6>
          <div class="border rounded p-3">
            <%= render "admin/reports/reportable_preview", report: @report %>
          </div>
        </div>
      </div>
    </div>

    <!-- 管理者ノート -->
    <div class="card">
      <div class="card-header"><h5 class="mb-0"><i class="fas fa-sticky-note me-2"></i>管理者ノート</h5></div>
      <div class="card-body">
        <%= form_with model: [:admin, @report], class: "mb-3" do |form| %>
          <div class="mb-3">
            <%= form.label :admin_note, "内部メモ（管理者のみ閲覧可能）", class: "form-label" %>
            <%= form.text_area :admin_note, rows: 4, class: "form-control" %>
          </div>
          <div class="text-end"><%= form.submit "ノートを保存", class: "btn btn-outline-primary" %></div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- サイドバー -->
  <div class="col-lg-4">
    <div class="card mb-4">
      <div class="card-header"><h5 class="mb-0"><i class="fas fa-cog me-2"></i>アクション</h5></div>
      <div class="card-body">
        <!-- ステータス変更 -->
        <div class="mb-3">
          <label class="form-label">ステータス変更</label>
          <div class="d-grid gap-2">
            <% unless @report.investigating? %>
              <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#modalReportStatusInvestigating">
                <i class="fas fa-search me-1"></i>調査中にする
              </button>
            <% end %>
            <% unless @report.resolved? %>
              <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalReportStatusResolved">
                <i class="fas fa-check me-1"></i>解決済みにする
              </button>
            <% end %>
            <% unless @report.dismissed? %>
              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalReportStatusDismissed">
                <i class="fas fa-times me-1"></i>却下する
              </button>
            <% end %>
            <% unless @report.pending? %>
              <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalReportStatusPending">
                <i class="fas fa-undo me-1"></i>未対応に戻す
              </button>
            <% end %>
          </div>
        </div>

        <hr>

        <!-- 削除（モーダル） -->
        <button type="button" class="btn btn-outline-danger btn-sm w-100" data-bs-toggle="modal" data-bs-target="#deleteReportModal">
          <i class="fas fa-trash me-1"></i>レポートを削除
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ===== ステータス変更モーダル群 ===== -->

<div class="modal fade" id="modalReportStatusInvestigating" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">確認</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">ステータスを「調査中」に変更します。よろしいですか？</div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
      <%= button_to admin_report_path(@report, report: { status: "investigating" }),
                    method: :patch, form_class: "d-inline", class: "btn btn-info", data: { turbo: false } do %>
        変更する
      <% end %>
    </div>
  </div></div>
</div>

<div class="modal fade" id="modalReportStatusResolved" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">確認</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">ステータスを「解決済み」に変更します。よろしいですか？</div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
      <%= button_to admin_report_path(@report, report: { status: "resolved" }),
                    method: :patch, form_class: "d-inline", class: "btn btn-success", data: { turbo: false } do %>
        変更する
      <% end %>
    </div>
  </div></div>
</div>

<div class="modal fade" id="modalReportStatusDismissed" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">確認</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">このレポートを「却下」にします。よろしいですか？</div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
      <%= button_to admin_report_path(@report, report: { status: "dismissed" }),
                    method: :patch, form_class: "d-inline", class: "btn btn-secondary", data: { turbo: false } do %>
        変更する
      <% end %>
    </div>
  </div></div>
</div>

<div class="modal fade" id="modalReportStatusPending" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">確認</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">ステータスを「未対応」に戻します。よろしいですか？</div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
      <%= button_to admin_report_path(@report, report: { status: "pending" }),
                    method: :patch, form_class: "d-inline", class: "btn btn-warning", data: { turbo: false } do %>
        変更する
      <% end %>
    </div>
  </div></div>
</div>

<!-- 削除モーダル -->
<div class="modal fade" id="deleteReportModal" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title text-danger">確認</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      このレポートを完全に削除します。<strong>この操作は取り消せません。</strong>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
      <%= button_to admin_report_path(@report),
                    method: :delete, form_class: "d-inline", class: "btn btn-danger", data: { turbo: false } do %>
        削除する
      <% end %>
    </div>
  </div></div>
</div>