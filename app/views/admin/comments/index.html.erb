<% content_for :page_title, "コメント管理" %>
<% content_for :page_description, "全コメントの管理・モデレーション" %>

<!-- 統計サマリー -->
<div class="row mb-4">
  <div class="col-md-12">
    <div class="card">
      <div class="card-body">
        <div class="row text-center">
          <div class="col-md-2">
            <h4 class="text-primary mb-0"><%= @stats[:total] %></h4>
            <small class="text-muted">総コメント数</small>
          </div>
          <div class="col-md-2">
            <h4 class="text-success mb-0"><%= @stats[:visible] %></h4>
            <small class="text-muted">表示中</small>
          </div>
          <div class="col-md-2">
            <h4 class="text-warning mb-0"><%= @stats[:hidden] %></h4>
            <small class="text-muted">非表示</small>
          </div>
          <div class="col-md-2">
            <h4 class="text-info mb-0"><%= @stats[:today] %></h4>
            <small class="text-muted">今日投稿</small>
          </div>
          <div class="col-md-2">
            <h4 class="text-secondary mb-0"><%= @stats[:week] %></h4>
            <small class="text-muted">今週投稿</small>
          </div>
          <div class="col-md-2">
            <h4 class="text-danger mb-0"><%= @stats[:reported] %></h4>
            <small class="text-muted">報告あり</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- フィルター・検索フォーム -->
<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">
      <i class="fas fa-filter me-2"></i>フィルター・検索
    </h5>
  </div>
  <div class="card-body">
    <%= form_with url: admin_comments_path, method: :get, local: true, class: "row g-3" do |form| %>
      <!-- 表示状態フィルター -->
      <div class="col-md-2">
        <%= form.label :status, "表示状態", class: "form-label" %>
        <%= form.select :status,
              options_for_select([['全て',''], ['表示中','visible'], ['非表示','hidden']],
                                 @filter_params&.fetch(:status, '')),
              {},
              { class: "form-select" } %>
      </div>

      <!-- レシピフィルター -->
      <div class="col-md-2">
        <%= form.label :recipe_id, "レシピID", class: "form-label" %>
        <%= form.text_field :recipe_id, 
            value: @filter_params[:recipe_id], 
            placeholder: "レシピID", 
            class: "form-control" %>
      </div>

      <!-- ユーザーフィルター -->
      <div class="col-md-2">
        <%= form.label :user_id, "ユーザーID", class: "form-label" %>
        <%= form.text_field :user_id, 
            value: @filter_params[:user_id], 
            placeholder: "ユーザーID", 
            class: "form-control" %>
      </div>

      <!-- 投稿期間フィルター -->
      <div class="col-md-2">
        <%= form.label :period, "投稿期間", class: "form-label" %>
        <%= form.select :period, 
            options_for_select([
              ['全期間', ''],
              ['今日', 'today'],
              ['今週', 'week'],
              ['今月', 'month']
            ], @filter_params[:period]), 
            {}, 
            { class: "form-select" } %>
      </div>

      <!-- ソート順 -->
      <div class="col-md-2">
        <%= form.label :sort, "並び順", class: "form-label" %>
        <%= form.select :sort, 
            options_for_select([
              ['新しい順', 'created_desc'],
              ['古い順', 'created_asc'],
              ['レシピ順', 'recipe'],
              ['ユーザー順', 'user']
            ], @filter_params[:sort]), 
            {}, 
            { class: "form-select" } %>
      </div>

      <!-- 検索・リセットボタン -->
      <div class="col-md-2 d-flex align-items-end">
        <div class="btn-group w-100" role="group">
          <%= form.submit "検索", class: "btn btn-primary" %>
          <%= link_to "リセット", admin_comments_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>

      <!-- キーワード検索 -->
      <div class="col-md-8">
        <%= form.label :search, "キーワード検索", class: "form-label" %>
        <%= form.text_field :search, 
            value: @filter_params[:search], 
            placeholder: "コメント内容、ユーザー名で検索...", 
            class: "form-control" %>
      </div>

      <!-- 表示件数 -->
      <div class="col-md-4">
        <%= form.label :per_page, "表示件数", class: "form-label" %>
        <%= form.select :per_page, 
            options_for_select([
              ['20件', '20'],
              ['50件', '50'],
              ['100件', '100']
            ], @filter_params[:per_page] || '20'), 
            {}, 
            { class: "form-select" } %>
      </div>
    <% end %>
  </div>
</div>

<!-- コメント一覧 -->
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">
      <i class="fas fa-comments me-2"></i>コメント一覧
      <span class="badge bg-secondary ms-2"><%= @comments.total_count %>件</span>
    </h5>
    <div class="btn-group" role="group">
      <button type="button" class="btn btn-outline-warning btn-sm" id="bulkActionBtn" disabled>
        <i class="fas fa-tasks me-1"></i>一括操作
      </button>
    </div>
  </div>
  
  <div class="card-body p-0">
    <% if @comments.any? %>
      <!-- 一括操作フォーム -->
      <div id="bulkActionForm" class="bg-light p-3 border-bottom" style="display: none;">
       <%= form_with url: bulk_admin_comments_path, method: :patch,
            class: "d-flex align-items-center gap-3", id: "bulk-form", local: true do |form| %>
          <%= form.select :bulk_action, 
              options_for_select([
                ['アクションを選択', ''],
                ['非表示にする', 'hide'],
                ['表示する', 'show'],
                ['削除する', 'delete']
              ]), 
              {},
              { class: "form-select", style: "width: 200px;" } %>
          <%= form.submit "実行", class: "btn btn-warning btn-sm" %>
          <button type="button" class="btn btn-outline-secondary btn-sm" id="cancelBulk">キャンセル</button>
        <% end %>
      </div>

      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th width="40">
                <input type="checkbox" id="selectAllComments" class="form-check-input">
              </th>
              <th>コメント内容</th>
              <th width="150">投稿者</th>
              <th width="200">レシピ</th>
              <th width="100">ステータス</th>
              <th width="120">投稿日時</th>
              <th width="120">アクション</th>
            </tr>
          </thead>
          <tbody>
            <% @comments.each do |comment| %>
              <tr class="<%= 'table-warning' if comment.hidden? %> <%= 'table-danger' if comment.reports.pending.any? %>">
                <td>
                  <input type="checkbox" name="comment_ids[]" value="<%= comment.id %>" 
                         class="form-check-input comment-checkbox">
                </td>
                <td>
                  <div class="position-relative">
                    <p class="mb-1" style="white-space: pre-line;">
                      <%= truncate(comment.content, length: 100) %>
                    </p>
                    
                    <!-- 報告バッジ -->
                    <% if comment.reports.pending.any? %>
                      <span class="badge bg-danger small">
                        <i class="fas fa-flag"></i>
                        <%= comment.reports.pending.count %>件報告
                      </span>
                    <% end %>
                  </div>
                </td>
                <td>
                  <div class="d-flex align-items-center">
                    <% if comment.user.avatar.attached? %>
                      <%= image_tag comment.user.avatar, 
                          class: "rounded-circle me-2", size: "30x30" %>
                    <% else %>
                      <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-2" 
                           style="width: 30px; height: 30px;">
                        <i class="fas fa-user text-white small"></i>
                      </div>
                    <% end %>
                    <div>
                      <div class="small fw-medium">
                        <%= link_to comment.user.display_name, admin_user_path(comment.user), 
                            class: "text-decoration-none" %>
                      </div>
                      <small class="text-muted">ID: <%= comment.user.id %></small>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="d-flex align-items-center">
                    <% if comment.recipe.image.attached? %>
                      <%= image_tag comment.recipe.image, 
                          class: "rounded me-2", size: "30x30", style: "object-fit: cover;" %>
                    <% else %>
                      <div class="rounded bg-light d-flex align-items-center justify-content-center me-2" 
                           style="width: 30px; height: 30px;">
                        <i class="fas fa-utensils text-muted small"></i>
                      </div>
                    <% end %>
                    <div>
                      <div class="small fw-medium">
                        <%= link_to truncate(comment.recipe.title, length: 20), 
                            admin_recipe_path(comment.recipe), 
                            class: "text-decoration-none" %>
                      </div>
                      <small class="text-muted">ID: <%= comment.recipe.id %></small>
                    </div>
                  </div>
                </td>
                <td>
                  <% if comment.hidden? %>
                    <span class="badge bg-warning">非表示</span>
                  <% else %>
                    <span class="badge bg-success">表示中</span>
                  <% end %>
                </td>
                <td>
                  <small class="text-muted">
                    <%= comment.created_at.strftime("%m/%d %H:%M") %>
                  </small>
                </td>
                <td>
                  <div class="btn-group" role="group">
                    <%= link_to admin_comment_path(comment), 
                        class: "btn btn-sm btn-outline-primary" do %>
                      <i class="fas fa-eye"></i>
                    <% end %>
                    
                    <div class="btn-group" role="group">
                      <button type="button" 
                              class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                              data-bs-toggle="dropdown">
                        <i class="fas fa-cog"></i>
                      </button>
                      <!-- アクションボタン -->
                      <ul class="dropdown-menu">
                        <% if comment.hidden? %>
                          <li>
                            <%= link_to unhide_admin_comment_path(comment), 
                                method: :patch,
                                class: "dropdown-item",
                                data: { turbo_method: :patch } do %>
                              <i class="fas fa-eye text-success me-2"></i>表示する
                            <% end %>
                          </li>
                        <% else %>
                          <li>
                            <%= link_to hide_admin_comment_path(comment), 
                                method: :patch,
                                class: "dropdown-item",
                                data: { turbo_method: :patch } do %>
                              <i class="fas fa-eye-slash text-warning me-2"></i>非表示にする
                            <% end %>
                          </li>
                        <% end %>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <%= link_to admin_comment_path(comment), 
                              method: :delete,
                              class: "dropdown-item text-danger",
                              data: { 
                                turbo_method: :delete,
                                confirm: "このコメントを削除しますか？"
                              } do %>
                            <i class="fas fa-trash me-2"></i>削除する
                          <% end %>
                        </li>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- ページネーション -->
      <div class="card-footer">
        <div class="d-flex justify-content-between align-items-center">
          <div class="text-muted">
            <%= page_entries_info @comments, entry_name: 'コメント' %>
          </div>
          <div>
            

            <%= paginate @comments, theme: 'bootstrap4' %>
          </div>
        </div>
      </div>
    <% else %>
      <!-- 空状態 -->
      <div class="text-center py-5">
        <i class="fas fa-comments text-muted fa-3x mb-3"></i>
        <h5 class="text-muted">コメントが見つかりません</h5>
        <p class="text-muted">
          <% if @filter_params.any? { |k, v| v.present? } %>
            検索条件を変更して再度お試しください。
          <% else %>
            まだコメントが投稿されていません。
          <% end %>
        </p>
        <% if @filter_params.any? { |k, v| v.present? } %>
          <%= link_to "フィルターをリセット", admin_comments_path, class: "btn btn-outline-primary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // チェックボックス関連の処理
  const selectAll = document.getElementById('selectAllComments');
  const checkboxes = document.querySelectorAll('.comment-checkbox');
  const bulkActionBtn = document.getElementById('bulkActionBtn');
  const bulkActionForm = document.getElementById('bulkActionForm');

  // 全選択/全解除
  selectAll?.addEventListener('change', function() {
    checkboxes.forEach(checkbox => {
      checkbox.checked = this.checked;
    });
    updateBulkActionButton();
  });

  // 個別チェックボックス
  checkboxes.forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      updateBulkActionButton();
      
      const checkedCount = document.querySelectorAll('.comment-checkbox:checked').length;
      if (selectAll) {
        selectAll.checked = checkedCount === checkboxes.length;
        selectAll.indeterminate = checkedCount > 0 && checkedCount < checkboxes.length;
      }
    });
  });

  // 一括操作ボタンの状態更新
  function updateBulkActionButton() {
    const checkedBoxes = document.querySelectorAll('.comment-checkbox:checked');
    bulkActionBtn.disabled = checkedBoxes.length === 0;
    
    if (checkedBoxes.length > 0) {
      bulkActionBtn.textContent = `一括操作 (${checkedBoxes.length}件)`;
    } else {
      bulkActionBtn.textContent = '一括操作';
    }
  }

  // 一括操作フォーム表示/非表示
  bulkActionBtn?.addEventListener('click', function() {
    if (!this.disabled) {
      bulkActionForm.style.display = bulkActionForm.style.display === 'none' ? 'block' : 'none';
    }
  });

  // 一括操作キャンセル
  document.getElementById('cancelBulk')?.addEventListener('click', function() {
    bulkActionForm.style.display = 'none';
  });

  // 一括操作フォーム送信時に選択されたIDを追加
  document.getElementById('bulk-form')?.addEventListener('submit', function(e) {
    const checkedBoxes = document.querySelectorAll('.comment-checkbox:checked');
    
    // 既存のhidden inputを削除
    this.querySelectorAll('input[name="comment_ids[]"]').forEach(input => input.remove());
    
    // 選択されたIDをhidden inputとして追加
    checkedBoxes.forEach(checkbox => {
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = 'comment_ids[]';
      hiddenInput.value = checkbox.value;
      this.appendChild(hiddenInput);
    });
  });
});
</script>