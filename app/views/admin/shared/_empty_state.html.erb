<% 
# 使用例: <%= render 'admin/shared/empty_state', 
#              icon: 'fas fa-users', title: 'ユーザーが見つかりません',
#              message: '検索条件を変更してください', 
#              action_text: 'リセット', action_path: admin_users_path %>
%>

<div class="text-center py-5">
  <i class="<%= icon %> text-muted fa-3x mb-3"></i>
  <h5 class="text-muted"><%= title %></h5>
  <p class="text-muted"><%= message %></p>
  
  <% if defined?(action_text) && defined?(action_path) && action_text && action_path %>
    <%= link_to action_text, action_path, class: "btn btn-outline-primary" %>
  <% end %>
</div>