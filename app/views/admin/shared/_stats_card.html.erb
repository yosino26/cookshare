<% 
# 使用例: <%= render 'admin/shared/stats_card', title: '総ユーザー数', 
#              value: 1234, icon: 'fas fa-users', color: 'primary', 
#              change: '+12', change_text: '今日', change_type: 'increase' %>
%>

<div class="card stat-card h-100">
  <div class="card-body text-center">
    <div class="d-flex align-items-center justify-content-center mb-2">
      <div class="rounded-circle bg-<%= color %> bg-opacity-10 p-3">
        <i class="<%= icon %> text-<%= color %> fa-2x"></i>
      </div>
    </div>
    <h3 class="mb-1"><%= number_with_delimiter(value) %></h3>
    <p class="text-muted mb-0"><%= title %></p>
    
    <% if defined?(change) && change.present? %>
      <small class="<%= change_type == 'increase' ? 'text-success' : 'text-danger' %>">
        <i class="fas fa-arrow-<%= change_type == 'increase' ? 'up' : 'down' %>"></i>
        <%= change_text %> <%= change %>
      </small>
    <% end %>
  </div>
</div>