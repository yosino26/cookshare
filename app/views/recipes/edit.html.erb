<div class="row justify-content-center">
  <div class="col-md-10">
    <div class="card shadow">
      <div class="card-body p-5">
        <h2 class="text-center mb-4">✏️ レシピを編集</h2>

        <%= form_with model: @recipe, local: true, multipart: true do |f| %>
          <%= render 'shared/error_messages', object: @recipe %>

          <!-- 基本情報セクション -->
          <div class="mb-5">
            <h4 class="border-bottom pb-2 mb-3">基本情報</h4>
            
            <div class="mb-3">
              <%= f.label :title, "レシピタイトル", class: "form-label" %>
              <%= f.text_field :title, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :image, "レシピ画像", class: "form-label" %>
              <%= f.file_field :image, class: "form-control", accept: "image/*" %>
              <% if @recipe.image.attached? %>
                <div class="mt-2">
                  <%= image_tag @recipe.image, class: "img-thumbnail", style: "max-height:150px;" %>
                  <small class="text-muted d-block">現在の画像</small>
                </div>
              <% end %>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <%= f.label :cooking_time, "調理時間（分）", class: "form-label" %>
                <%= f.number_field :cooking_time, class: "form-control", min: 1, max: 999 %>
              </div>
              <div class="col-md-6">
                <%= f.label :servings, "人数", class: "form-label" %>
                <%= f.number_field :servings, class: "form-control", min: 1, max: 20 %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :description, "レシピの説明", class: "form-label" %>
              <%= f.text_area :description, class: "form-control", rows: 4 %>
            </div>
          </div>

          <!-- 材料セクション -->
          <div class="mb-5">
            <h4 class="border-bottom pb-2 mb-3">材料</h4>
            <div id="ingredients-container">
              <%= f.fields_for :ingredients do |ingredient_f| %>
                <div class="ingredient-field mb-3">
                  <div class="row align-items-end">
                    <div class="col-md-6">
                      <%= ingredient_f.label :name, "材料名", class: "form-label" %>
                      <%= ingredient_f.text_field :name, class: "form-control", required: true %>
                    </div>
                    <div class="col-md-4">
                      <%= ingredient_f.label :amount, "分量", class: "form-label" %>
                      <%= ingredient_f.text_field :amount, class: "form-control", required: true %>
                      <%= ingredient_f.hidden_field :id %>
                    </div>
                    <div class="col-md-2">
                      <button type="button" class="btn btn-outline-danger remove-ingredient">削除</button>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <!-- 手順セクション -->
          <div class="mb-5">
            <h4 class="border-bottom pb-2 mb-3">作り方</h4>
            <div id="steps-container">
              <%= f.fields_for :steps do |step_f| %>
                <div class="step-field mb-3">
                  <div class="row align-items-end">
                    <div class="col-md-10">
                      <%= step_f.label :instruction, "手順", class: "form-label" %>
                      <%= step_f.text_area :instruction, class: "form-control", rows: 3, required: true %>
                      <%= step_f.hidden_field :id %>
                    </div>
                    <div class="col-md-2">
                      <button type="button" class="btn btn-outline-danger remove-step">削除</button>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <!-- 更新ボタン -->
          <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <%= link_to "キャンセル", recipe_path(@recipe), class: "btn btn-outline-secondary" %>
            <%= f.submit "更新する", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
