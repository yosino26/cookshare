<div class="row justify-content-center">
  <div class="col-md-10">
    <div class="card shadow">
      <div class="card-body p-5">
        <h2 class="text-center mb-4">🍳 新しいレシピを投稿</h2>

        <%= form_with model: @recipe, local: true, multipart: true do |f| %>
          <%= render 'shared/error_messages', object: @recipe %>

          <!-- 基本情報セクション -->
          <div class="mb-5">
            <h4 class="border-bottom pb-2 mb-3">基本情報</h4>
            
            <div class="mb-3">
              <%= f.label :title, "レシピタイトル", class: "form-label" %>
              <%= f.text_field :title, class: "form-control", placeholder: "例: 簡単トマトパスタ" %>
            </div>

            <div class="mb-3">
              <%= f.label :image, "レシピ画像", class: "form-label" %>
              <%= f.file_field :image, class: "form-control", accept: "image/*" %>
              <small class="text-muted">JPG, PNG形式のファイルをアップロードできます</small>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <%= f.label :cooking_time, "調理時間（分）", class: "form-label" %>
                <%= f.number_field :cooking_time, class: "form-control", min: 1, max: 999 %>
              </div>
              <div class="col-md-6">
                <%= f.label :servings, "人数", class: "form-label" %>
                <%= f.number_field :servings, class: "form-control", min: 1, max: 20 %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :description, "レシピの説明", class: "form-label" %>
              <%= f.text_area :description, class: "form-control", rows: 4, 
                             placeholder: "このレシピについて簡単に説明してください..." %>
            </div>
          </div>

          <!-- 材料セクション -->
          <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h4 class="border-bottom pb-2 mb-0">材料</h4>
              <button type="button" id="add-ingredient" class="btn btn-outline-primary btn-sm">
                ➕ 材料を追加
              </button>
            </div>
            
            <div id="ingredients-container">
              <!-- 最初の素材フィールド -->
              <%= f.fields_for :ingredients, @recipe.ingredients.build(order_number: 1) do |ingredient_f| %>
                <div class="ingredient-field mb-3">
                  <div class="row align-items-end">
                    <div class="col-md-6">
                      <%= ingredient_f.label :name, "材料名", class: "form-label" %>
                      <%= ingredient_f.text_field :name, class: "form-control", placeholder: "例: トマト", required: true %>
                    </div>
                    <div class="col-md-4">
                      <%= ingredient_f.label :amount, "分量", class: "form-label" %>
                      <%= ingredient_f.text_field :amount, class: "form-control", placeholder: "例: 2個", required: true %>
                      <%= ingredient_f.hidden_field :order_number, value: (ingredient_f.object.order_number || 1) %>
                      <%= ingredient_f.hidden_field :id %>
                    </div>
                    <div class="col-md-2">
                      <button type="button" class="btn btn-outline-danger remove-ingredient">削除</button>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>

<!-- 材料用のテンプレート（非表示） -->
<template id="ingredient-template">
  <div class="ingredient-field mb-3">
    <div class="row align-items-end">
      <div class="col-md-6">
        <label class="form-label" for="recipe_ingredients_NEW_RECORD_name">材料名</label>
        <input type="text" name="recipe[ingredients_attributes][NEW_RECORD][name]"
               id="recipe_ingredients_NEW_RECORD_name"
               class="form-control" placeholder="例: トマト" required="required">
      </div>
      <div class="col-md-4">
        <label class="form-label" for="recipe_ingredients_NEW_RECORD_amount">分量</label>
        <input type="text" name="recipe[ingredients_attributes][NEW_RECORD][amount]"
               id="recipe_ingredients_NEW_RECORD_amount"
               class="form-control" placeholder="例: 2個" required="required">
        <input type="hidden" name="recipe[ingredients_attributes][NEW_RECORD][order_number]" value="">
      </div>
      <div class="col-md-2">
        <button type="button" class="btn btn-outline-danger remove-ingredient">削除</button>
      </div>
    </div>
  </div>
</template>

          </div>

        <!-- 手順セクション -->
          <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h4 class="border-bottom pb-2 mb-0">作り方</h4>
              <button type="button" id="add-step" class="btn btn-outline-primary btn-sm">
                ➕ 手順を追加
              </button>
            </div>

            <div id="steps-container">
              <!-- 最初の手順フィールド -->
              <%= f.fields_for :steps, @recipe.steps.build(step_number: 1) do |step_f| %>
                <div class="step-field mb-3">
                  <div class="row align-items-end">
                    <div class="col-md-10">
                      <%= step_f.label :instruction, "手順 1", class: "form-label" %>
                      <%= step_f.text_area :instruction, class: "form-control", rows: 3,
                                           placeholder: "手順を詳しく説明してください", required: true %>
                      <%= step_f.hidden_field :step_number, value: (step_f.object.step_number || 1) %>
                      <%= step_f.hidden_field :id %>
                    </div>
                    <div class="col-md-2">
                      <button type="button" class="btn btn-outline-danger remove-step">削除</button>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <!-- 手順用のテンプレート（非表示） -->
          <template id="step-template">
            <div class="step-field mb-3">
              <div class="row align-items-end">
                <div class="col-md-10">
                  <label class="form-label" for="recipe_steps_NEW_RECORD_instruction">手順</label>
                  <textarea name="recipe[steps_attributes][NEW_RECORD][instruction]"
                            id="recipe_steps_NEW_RECORD_instruction"
                            class="form-control" rows="3" placeholder="手順を詳しく" required></textarea>
                  <input type="hidden" name="recipe[steps_attributes][NEW_RECORD][step_number]" value="">
                </div>
                <div class="col-md-2">
                  <button type="button" class="btn btn-outline-danger remove-step">削除</button>
                </div>
              </div>
            </div>
          </template>
          

          <!-- 投稿ボタン -->
          <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <%= link_to "キャンセル", recipes_path, class: "btn btn-outline-secondary" %>
            <%= f.submit "投稿する", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>