<%= form_with model: recipe, local: true, multipart: true do |f| %>
  <%= render 'shared/error_messages', object: recipe %>

  <!-- 基本情報 -->
  <div class="mb-5">
    <h4 class="border-bottom pb-2 mb-3">基本情報</h4>

    <div class="mb-3">
      <%= f.label :title, "レシピタイトル", class: "form-label" %>
      <%= f.text_field :title, class: "form-control", placeholder: "例: 簡単トマトパスタ" %>
    </div>

    <div class="mb-3">
      <%= f.label :image, "レシピ画像", class: "form-label" %>
      <%= f.file_field :image, class: "form-control", accept: "image/*" %>
      <small class="text-muted">JPG, PNG形式のファイルをアップロードできます</small>
    </div>

    <!-- カテゴリ選択 -->
    <div class="mb-3">
      <%= f.label :category_ids, "カテゴリ", class: "form-label" %>
      <%= f.collection_check_boxes :category_ids, Category.order(:name), :id, :name do |b| %>
        <div class="form-check form-check-inline">
          <%= b.check_box(class: "form-check-input") %>
          <%= b.label(class: "form-check-label") %>
        </div>
      <% end %>
      <small class="text-muted">複数選択可能です</small>
    </div>

    <div class="row mb-3">
      <div class="col-md-6">
        <%= f.label :cooking_time, "調理時間（分）", class: "form-label" %>
        <%= f.number_field :cooking_time, class: "form-control", min: 1, max: 999 %>
      </div>
      <div class="col-md-6">
        <%= f.label :servings, "人数", class: "form-label" %>
        <%= f.number_field :servings, class: "form-control", min: 1, max: 20 %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :description, "作り方・説明", class: "form-label" %>
      <%= f.text_area :description, class: "form-control", rows: 8,
                      placeholder: "レシピの詳しい説明や作り方を書いてください..." %>
    </div>
  </div>

  <!-- 材料セクション -->
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="border-bottom pb-2 mb-0">材料</h4>
      <button type="button" id="add-ingredient" class="btn btn-outline-primary btn-sm">➕ 材料を追加</button>
    </div>

    <div id="ingredients-container">
      <% if recipe.ingredients.any? %>
        <%= f.fields_for :ingredients do |ingredient_f| %>
          <%= render 'recipes/ingredient_fields', f: ingredient_f %>
        <% end %>
      <% else %>
        <%= f.fields_for :ingredients, recipe.ingredients.build(order_number: 1) do |ingredient_f| %>
          <%= render 'recipes/ingredient_fields', f: ingredient_f %>
        <% end %>
      <% end %>
    </div>

    <!-- JSテンプレート（非表示） -->
    <%= render 'recipes/ingredient_template' %>
  </div>

  <!-- 手順セクション -->
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="border-bottom pb-2 mb-0">作り方</h4>
      <button type="button" id="add-step" class="btn btn-outline-primary btn-sm">➕ 手順を追加</button>
    </div>

    <div id="steps-container">
      <% if recipe.steps.any? %>
        <%= f.fields_for :steps do |step_f| %>
          <%= render 'recipes/step_fields', f: step_f %>
        <% end %>
      <% else %>
        <%= f.fields_for :steps, recipe.steps.build(step_number: 1) do |step_f| %>
          <%= render 'recipes/step_fields', f: step_f %>
        <% end %>
      <% end %>
    </div>

    <!-- JSテンプレート（非表示） -->
    <%= render 'recipes/step_template' %>
  </div>

  <!-- 送信 -->
  <div class="d-grid gap-2 d-md-flex justify-content-md-end">
    <%= link_to "キャンセル", recipes_path, class: "btn btn-outline-secondary" %>
    <%= f.submit recipe.persisted? ? "更新する" : "投稿する", class: "btn btn-primary btn-lg" %>
  </div>
<% end %>
