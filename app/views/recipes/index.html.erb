<!-- ヒーローセクション -->
<div class="hero-section text-center py-5 mb-5"
     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; border-radius: 20px;">
  <div class="container">
    <h1 class="display-4 fw-bold">🍳 CookShare</h1>
    <p class="lead mb-4">あなたの美味しいレシピを世界と共有しよう</p>

    <div class="row text-center mb-4">
      <div class="col-md-4">
        <h3><%= @total_recipes %></h3>
        <p>投稿レシピ数</p>
      </div>
      <div class="col-md-4">
        <h3><%= @total_users %></h3>
        <p>登録ユーザー数</p>
      </div>
      <div class="col-md-4">
        <h3><%= Date.current.strftime("%m/%d") %></h3>
        <p>今日の日付</p>
      </div>
    </div>

    <div class="mt-4">
      <% if user_signed_in? %>
        <%= link_to "レシピを投稿", new_recipe_path, class: "btn btn-warning btn-lg me-3" %>
        <%= link_to "レシピを探す", "#recipes-section", class: "btn btn-outline-light btn-lg" %>
      <% else %>
        <%= link_to "今すぐ参加", new_user_registration_path, class: "btn btn-warning btn-lg me-3" %>
        <%= link_to "レシピを見る", "#recipes-section", class: "btn btn-outline-light btn-lg" %>
      <% end %>
    </div>

  </div>
</div>

<!-- Cardセクション -->
<% if @recipes.present? %>
<div class="row">
  <% @recipes.each do |recipe| %>
  <% if @recipes.any? %>
   <div id="recipes-section" class="row">
      <%= render partial: "card", collection: @recipes, as: :recipe %>
   </div>
   <div class="d-flex justify-content-center mt-4">
      <%= paginate @recipes %>
    </div>
  <% else %>
    <%= render "empty_state" %>
  <% end %>
 <% end %>
</div>

    <!-- ページネーション -->
  <div class="d-flex justify-content-center mt-4">
      <%= paginate @recipes %>
    </div>
    <% else %>
    <div class="text-center py-5">
      <div class="mb-4">
        <span style="font-size: 4rem;">🔍</span>
      </div>
      <h4>レシピが見つかりませんでした</h4>
      <p class="text-muted">検索条件を変更して再度お試しください</p>
      <%= link_to "すべてのレシピを見る", recipes_path, class: "btn btn-primary" %>
    </div>
    <% end %>
  </div>