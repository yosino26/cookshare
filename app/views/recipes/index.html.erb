<!-- ヒーローセクション -->
<div class="hero-section text-center py-5 mb-5"
     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; border-radius: 20px;">
  <div class="container">
    <h1 class="display-4 fw-bold">🍳 CookShare</h1>
    <p class="lead mb-4">あなたの美味しいレシピを世界と共有しよう</p>

    <div class="row text-center mb-4">
      <div class="col-md-4">
        <h3><%= @total_recipes %></h3>
        <p>投稿レシピ数</p>
      </div>
      <div class="col-md-4">
        <h3><%= @total_users %></h3>
        <p>登録ユーザー数</p>
      </div>
      <div class="col-md-4">
        <h3><%= Date.current.strftime("%m/%d") %></h3>
        <p>今日の日付</p>
      </div>
    </div>

    <div class="mt-4">
      <% if user_signed_in? %>
        <%= link_to "レシピを投稿", new_recipe_path, class: "btn btn-warning btn-lg me-3" %>
        <%= link_to "レシピを探す", "#recipes-section", class: "btn btn-outline-light btn-lg" %>
      <% else %>
        <%= link_to "今すぐ参加", new_user_registration_path, class: "btn btn-warning btn-lg me-3" %>
        <%= link_to "レシピを見る", "#recipes-section", class: "btn btn-outline-light btn-lg" %>
      <% end %>
    </div>

  </div>
</div>

<!-- 検索セクション -->
<div class="search-section bg-white p-4 rounded shadow-sm mb-4">
  <%= form_with url: recipes_path, method: :get, local: true, class: "row g-3" do |f| %>
    <div class="col-md-4">
      <%= f.text_field :search, value: params[:search], 
                       class: "form-control", 
                       placeholder: "レシピ名・材料で検索..." %>
    </div>
    
    <div class="col-md-3">
      <%= f.select :cooking_time, 
                   options_for_select([
                     ['調理時間で絞り込み', ''],
                     ['15分以内', 15],
                     ['30分以内', 30],
                     ['60分以内', 60]
                   ], params[:cooking_time]),
                   {}, { class: "form-select" } %>
    </div>
    
    <div class="col-md-3">
      <%= f.select :sort,
                   options_for_select([
                     ['新着順', ''],
                     ['人気順（お気に入り）', 'popular'],
                     ['評価順', 'top_rated'],
                     ['調理時間順', 'cooking_time']
                   ], params[:sort]),
                   {}, { class: "form-select" } %>
    </div>
    
    <div class="col-md-2">
      <%= f.submit "検索", class: "btn btn-primary w-100" %>
    </div>
  <% end %>
</div>

<!-- Cardセクション -->
<% if @recipes.present? %>
<div class="row">
  <% if @recipes.any? %>
   <div id="recipes-section" class="row">
      <%= render partial: "card", collection: @recipes, as: :recipe %>
   </div>
   <div class="d-flex justify-content-center mt-4">
      <%= paginate @recipes %>
    </div>
  <% else %>
    <%= render "empty_state" %>
  <% end %>
</div>

    <!-- ページネーション -->
  <div class="d-flex justify-content-center mt-4">
      <%= paginate @recipes %>
    </div>
    <% else %>
    <div class="text-center py-5">
      <div class="mb-4">
        <span style="font-size: 4rem;">🔍</span>
      </div>
      <h4>レシピが見つかりませんでした</h4>
      <p class="text-muted">検索条件を変更して再度お試しください</p>
      <%= link_to "すべてのレシピを見る", recipes_path, class: "btn btn-primary" %>
    </div>
    <% end %>
  </div>