<!-- app/views/recipes/index.html.erb -->
<div class="hero-section text-center py-5 mb-5">
  <div class="container">
    <h1 class="display-4 fw-bold text-primary">🍳 CookShare</h1>
    <p class="lead">あなたの美味しいレシピを世界と共有しよう</p>
    <div class="mt-4">
      <%= link_to "レシピを投稿", new_recipe_path,class: "btn btn-primary btn-lg me-3" %>
      <button class="btn btn-outline-primary btn-lg">レシピを探す</button>
    </div>
  </div>
</div>
   
<!-- カード一覧 -->
<div class="row">
  <% @recipes.each do |recipe| %>
    <div class="col-md-4 mb-4">
      <div class="card recipe-card h-100">

        <%# 画像（ActiveStorage 導入前後どちらでも動く分岐） %>
        <% has_image =
             if recipe.respond_to?(:image) && recipe.image.respond_to?(:attached?)
               recipe.image.attached?                                 # ActiveStorage 用
             else
               recipe.image.present?                                  # 文字列URLなどの場合
             end %>

        <% if has_image %>
          <%# ActiveStorage の場合は variant / それ以外はそのまま %>
          <% if recipe.respond_to?(:image) && recipe.image.respond_to?(:variant) %>
            <%= image_tag recipe.image.variant(resize_to_fill: [600, 400]),
                          class: "card-img-top", alt: recipe.title %>
          <% else %>
            <%= image_tag recipe.image, class: "card-img-top", alt: recipe.title %>
          <% end %>
        <% else %>
          <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
            <span class="text-muted">🍝 画像なし</span>
          </div>
        <% end %>

        <div class="card-body">
          <h5 class="card-title"><%= recipe.title %></h5>
          <p class="card-text text-muted">
            調理時間: <%= recipe.cooking_time %>分 |
            <%= recipe.servings %>人分
          </p>

          <div class="d-flex justify-content-between align-items-center">
            <%= link_to "詳細を見る", recipe_path(recipe), class: "btn btn-outline-primary btn-sm" %>
            <small class="text-muted">
              by <%= link_to recipe.user.name, user_path(recipe.user) %>
            </small>
          </div>
        </div>

      </div>
    </div>
  <% end %>
</div>