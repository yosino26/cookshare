<div class="row">
  <!-- 左カラム -->
  <div class="col-md-4">
    <!-- フォローセクション -->
    <div class="card mb-3">
      <div class="card-body text-center">
        <!-- アバター表示 -->
        <div class="avatar-large mb-3">
          <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar, class: "rounded-circle", style: "width: 120px; height: 120px; object-fit: cover;" %>
          <% else %>
            <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center text-white"
                 style="width: 120px; height: 120px; font-size: 48px;">
              👨‍🍳
            </div>
          <% end %>
        </div>

        <h4><%= @user.name %></h4>

        <!-- フォロー・フォロワー数表示 -->
        <div class="user-stats row text-center mb-3">
          <div class="col-4">
            <strong><%= @user.recipe_count %></strong><br>
            <small class="text-muted">レシピ</small>
          </div>
          <div class="col-4">
            <strong><%= @user.follower_count %></strong><br>
            <small class="text-muted">フォロワー</small>
          </div>
          <div class="col-4">
            <strong><%= @user.following_count %></strong><br>
            <small class="text-muted">フォロー中</small>
          </div>
        </div>

        <!-- フォローボタン -->
        <%= render 'shared/follow_button', user: @user %>

        <% if @user.bio.present? %>
          <div class="mt-3">
            <p class="text-muted"><%= simple_format(@user.bio) %></p>
          </div>
        <% end %>

        <div class="mt-3">
          <small class="text-muted">
            参加日: <%= @user.created_at.strftime('%Y年%m月') %>
          </small>
        </div>

        <% if current_user == @user %>
          <div class="mt-3">
            <%= link_to "プロフィール編集", edit_user_path(@user), class: "btn btn-outline-primary" %>
          </div>
        <% end %>
      </div>
    </div><!-- フォローセクション終わり -->

    <!-- 投稿者情報 -->
    <div class="card mb-3">
      <div class="card-body">
        <h6 class="card-title">投稿者情報</h6>
        <div class="d-flex align-items-center">
          <div class="avatar-circle me-3">👨‍🍳</div>
          <div>
            <strong><%= @recipe.user.name %></strong><br>
            <small class="text-muted">
              投稿レシピ数: <%= @recipe.user.recipe_count %>件
            </small>
          </div>
        </div>
      </div>
    </div>

    <!-- 栄養情報カード（将来的な拡張用） -->
    <div class="card">
      <div class="card-body">
        <h6 class="card-title">レシピ情報</h6>
        <ul class="list-unstyled mb-0">
          <li>調理時間: <%= @recipe.cooking_time %>分</li>
          <li>人数: <%= @recipe.servings %>人分</li>
          <li>材料数: <%= @recipe.ingredients.count %>種類</li>
          <li>手順数: <%= @recipe.steps.count %>ステップ</li>
        </ul>
      </div>
    </div>
  </div><!-- 左カラム終わり -->


      <!-- カードセクション -->
      <div class="col-md-8">
        <div class="card shadow">
          <% if @recipe.image.present? %>
            <div class="recipe-image-container">
              <%= image_tag @recipe.image, class: "card-img-top recipe-main-image", 
                            alt: @recipe.title %>
            </div>
          <% else %>
            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                 style="height: 300px;">
              <span class="text-muted fs-1">🍽️</span>
            </div>
          <% end %>
          
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <h1 class="card-title h3"><%= @recipe.title %></h1>
              <% if current_user == @recipe.user %>
                <div class="btn-group">
                  <%= link_to "編集", edit_recipe_path(@recipe), 
                              class: "btn btn-outline-primary btn-sm" %>
                  <%= link_to "削除", recipe_path(@recipe), method: :delete,
                              class: "btn btn-outline-danger btn-sm",
                              confirm: "本当に削除しますか？" %>
                </div>
              <% end %>
            </div>
            
            <div class="recipe-meta mb-4">
              <span class="badge bg-primary me-2">
                ⏰ <%= @recipe.cooking_time %>分
              </span>
              <span class="badge bg-success me-2">
                👥 <%= @recipe.servings %>人分
              </span>
              <span class="badge bg-info">
                👨‍🍳 <%= @recipe.user.name %>
              </span>
            </div>

            <!-- カテゴリ表示追加 -->
            <% @recipe.categories.each do |category| %>
            <%= link_to category.name, recipes_path(category: category.id), 
                        class: "badge bg-secondary text-decoration-none me-1" %>
            <% end %>
            
            <div class="recipe-description mb-4">
              <h5>レシピの説明</h5>
              <p class="card-text"><%= simple_format(@recipe.description) %></p>
            </div>
        
        <!-- 材料セクション -->
        <% if @recipe.ingredients.any? %>
          <div class="ingredients-section mb-4">
            <h5 class="border-bottom pb-2">🧄 材料（<%= @recipe.servings %>人分）</h5>
            <div class="row">
              <% @recipe.ordered_ingredients.each do |ingredient| %>
                <div class="col-md-6 mb-2">
                  <div class="d-flex justify-content-between align-items-center ingredient-item">
                    <span class="ingredient-name"><%= ingredient.name %></span>
                    <span class="ingredient-amount badge bg-light text-dark">
                      <%= ingredient.amount %>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
        
        <!-- 手順セクション -->
        <% if @recipe.steps.any? %>
          <div class="steps-section mb-4">
            <h5 class="border-bottom pb-2">👨‍🍳 作り方</h5>
            <% @recipe.ordered_steps.each_with_index do |step, index| %>
              <div class="step-item mb-3">
                <div class="d-flex">
                  <div class="step-number me-3">
                    <span class="badge bg-primary rounded-circle step-badge">
                      <%= index + 1 %>
                    </span>
                  </div>
                  <div class="step-content">
                    <p class="mb-0"><%= simple_format(step.instruction) %></p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
        
        <div class="text-muted small">
          投稿日: <%= @recipe.created_at.strftime("%Y年%m月%d日") %>
        </div>
      </div>
    </div>
  </div>


<!-- コメントセクション（全幅） -->
<div class="row mt-5">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">💬 コメント (<%= @recipe.comment_count %>)</h5>
      </div>

      <div class="card-body">
        <!-- コメント投稿フォーム -->
        <% if user_signed_in? %>
          <%= form_with model: [@recipe, Comment.new], local: true, class: "mb-4" do |f| %>
            <div class="mb-3">
              <%= f.text_area :content, class: "form-control", rows: 3,
                              placeholder: "コメントを入力してください..." %>
            </div>
            <%= f.submit "コメント投稿", class: "btn btn-primary" %>
          <% end %>
        <% else %>
          <div class="alert alert-info">
            コメントを投稿するには<%= link_to "ログイン", new_user_session_path %>してください
          </div>
        <% end %>

        <!-- コメント一覧 -->
        <div class="comments-list">
          <% @recipe.comments.includes(:user).recent.each do |comment| %>
            <div class="comment-item border-bottom pb-3 mb-3">
              <div class="d-flex justify-content-between align-items-start">
                <div class="d-flex">
                  <div class="avatar-circle me-3">👨‍💼</div>
                  <div>
                    <strong><%= comment.user.name %></strong>
                    <small class="text-muted">
                      <%= time_ago_in_words(comment.created_at) %>前
                    </small>
                  </div>
                </div>
                <!-- 通報ボタン -->
                <div class="btn-group">
                  <% if user_signed_in? && current_user != comment.user %>
                    <% if !comment.reported_by?(current_user) %>
                      <%= link_to "このコメントを通報",
                          new_report_path(comment_id: comment.id),
                          class: "btn btn-outline-danger btn-sm",
                          "aria-label": "Report this comment" %>
                    <% else %>
                      <button class="btn btn-outline-secondary btn-sm" disabled>通報済み</button>
                    <% end %>
                  <% end %>

                <% if current_user == comment.user %>
                  <%= link_to "削除", recipe_comment_path(@recipe, comment),
                              method: :delete,
                              class: "btn btn-outline-danger btn-sm",
                              confirm: "本当に削除しますか？",
                              data: { turbo_method: :delete } %>
                <% end %>
              </div>
              <div class="mt-2">
                <p class="mb-0"><%= simple_format(comment.content) %></p>
              </div>
            </div>
          <% end %>

          <% if @recipe.comments.empty? %>
            <div class="text-center text-muted py-4">
              まだコメントがありません
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 評価機能（必要に応じて全幅のまま） -->
<div class="row my-4">
  <div class="col-12">
    <div class="recipe-rating">
      <%= render 'shared/rating_system', recipe: @recipe %>
    </div>
  </div>
</div>
<!-- 通報ボタン -->
<% unless @recipe.user == current_user %>
  <% if user_signed_in? && !@recipe.reported_by?(current_user) %>
    <%= link_to t("reports.report_this"),
        new_report_path(recipe_id: @recipe.id),
        class: "btn btn-outline-danger btn-sm", "aria-label": t("reports.aria_report_recipe") %>
  <% end %>
<% end %>
<div class="text-center mt-4">
  <%= link_to "レシピ一覧に戻る", recipes_path, class: "btn btn-outline-primary" %>
</div>
<% if user_signed_in? %>
<%= link_to "マイページ", user_path(current_user), class: "btn btn-primary" %>
<% end %>

<%= link_to "投稿者ページ", user_path(@recipe.user), class: "btn btn-outline-secondary" %>
</div>