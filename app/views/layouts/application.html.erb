<!DOCTYPE html>
<html>
  <head>
    <title>🍳 CookShare - レシピを共有しよう</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- ヘッダー -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand" do %>
          🍳 CookShare
        <% end %>
        
        <div class="navbar-nav ms-auto">
          <% if user_signed_in? %>
           <!-- ログイン済みの場合 -->
            <span class="navbar-text me-3">
               こんにちは、<%= current_user.name %>さん
            </span>
            <%= link_to "レシピ投稿", new_recipe_path, class: "nav-link" %>
            <%= link_to "マイページ", user_path(current_user), class: "nav-link" %>
            <%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: "nav-link" %>                     
          <% else %>
            <!-- 未ログインの場合 -->
            <%= link_to "ログイン", new_user_session_path, class: "nav-link" %>
            <%= link_to "新規登録", new_user_registration_path, class: "nav-link" %>
          <% end %>
        </div>
      </div>
    </nav>
    
    <!-- フラッシュメッセージ -->
    <% if notice %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>
    
    <% if alert %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <!-- メインコンテンツ -->
    <main class="container my-4">
      <%= yield %>
    </main>

    <!-- フッター -->
    <footer class="bg-light text-center py-4 mt-5">
      <div class="container">
        <p class="mb-0">&copy; 2024 CookShare. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>